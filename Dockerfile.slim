# Slim pure-Telegram build of the hermes-agent image (mmcen/hermes-anynines:slim).
#
# What is CUT vs the stock Dockerfile (deploy target: Railway, HERMES_DASHBOARD=0,
# Telegram gateway only):
#   * Node 26 / npm / Playwright + Chromium  — web/TUI frontend and browser tooling
#   * The web + ui-tui frontend builds       — dashboard (`hermes dashboard`) and TUI
#   * The dashboard s6 service slot          — gateway/cloudflared/sshd stay supervised
#   * ffmpeg / docker-cli                    — voice bubbles degrade to file sends (the
#                                              adapter already handles missing ffmpeg);
#                                              terminal backend is local, no sandboxes
#   * Build toolchain (gcc/g++/make/cmake)   — moved into the python_deps builder stage;
#                                              only the built venv + libfts5_cjk.so land
#                                              in the pulled image
#   * Heavy python extras                    — core + python-telegram-bot only (no
#                                                discord/matrix/teams/google-chat/slack/
#                                                anthropic/bedrock/azure/hindsight/otlp)
#   * Non-runtime source                     — website/ evals/ tests/ web/ ui-tui/ apps/
#                                                optional-mcps/ optional-skills/ excluded
#   * The CJK FTS5 loadable extension is PREBUILT here and shipped via
#     HERMES_FTS5_CJK_SO (the stock image relies on runtime gcc + ~/.hermes/lib).
#
# What is KEPT: s6-overlay supervision, cloudflared (TUNNEL_TOKEN), sshd
# (SSH_ENABLED), git + ripgrep (agent tools), the fixed SQLite 3.53 library,
# bundled skills + plugin catalog, and the full state/portability layer —
# the volume state from the stock image stays fully compatible.
#
# Build (CI does this — see .github/workflows/docker-slim.yml):
#   docker build -f Dockerfile.slim -t mmcen/hermes-anynines:slim-base .
#   docker build --build-arg BASE_IMAGE=mmcen/hermes-anynines:slim-base \
#     -f Dockerfile.anynines -t mmcen/hermes-anynines:slim .
#
# Deploy: Railway service image `mmcen/hermes-anynines:slim` — the anynines
# wrapper (Dockerfile.anynines) on top is unchanged, so the entrypoint /
# s6 menu / session-env contract is identical to :latest.

# --- fixed SQLite 3.53 (WAL-reset bug workaround; verbatim from Dockerfile) ---
FROM debian:13.4 AS sqlite_build
ARG SQLITE_AUTOCONF_VERSION=3530400
ARG SQLITE_SHA256=0e9483900e92cd5de8fd48d16bf9200145a61f7fd5be542a5ac81d8a9516eb9c
RUN apt-get -o Acquire::Retries=3 update && \
    apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
        build-essential ca-certificates curl && \
    rm -rf /var/lib/apt/lists/* && \
    (curl -fsSL --retry 1 --retry-all-errors --connect-timeout 15 --max-time 60 \
        -o /tmp/sqlite.tar.gz \
        "https://sqlite.org/2026/sqlite-autoconf-${SQLITE_AUTOCONF_VERSION}.tar.gz" || \
     curl -fsSL --retry 3 --retry-all-errors --connect-timeout 15 --max-time 120 \
        -o /tmp/sqlite.tar.gz \
        "https://sources.buildroot.net/sqlite/sqlite-autoconf-${SQLITE_AUTOCONF_VERSION}.tar.gz") && \
    printf '%s  %s\n' "${SQLITE_SHA256}" /tmp/sqlite.tar.gz > /tmp/sqlite.sha256 && \
    sha256sum -c /tmp/sqlite.sha256 && \
    tar -xzf /tmp/sqlite.tar.gz -C /tmp && \
    cd "/tmp/sqlite-autoconf-${SQLITE_AUTOCONF_VERSION}" && \
    CFLAGS="-O2 \
        -DSQLITE_ENABLE_FTS3 \
        -DSQLITE_ENABLE_FTS3_PARENTHESIS \
        -DSQLITE_ENABLE_FTS4 \
        -DSQLITE_ENABLE_FTS5 \
        -DSQLITE_ENABLE_RTREE \
        -DSQLITE_ENABLE_GEOPOLY \
        -DSQLITE_ENABLE_COLUMN_METADATA \
        -DSQLITE_ENABLE_UNLOCK_NOTIFY \
        -DSQLITE_ENABLE_DBSTAT_VTAB \
        -DSQLITE_ENABLE_DBPAGE_VTAB \
        -DSQLITE_ENABLE_MATH_FUNCTIONS \
        -DSQLITE_ENABLE_PREUPDATE_HOOK \
        -DSQLITE_ENABLE_SESSION \
        -DSQLITE_SECURE_DELETE \
        -DSQLITE_THREADSAFE=1 \
        -DSQLITE_MAX_VARIABLE_NUMBER=250000" \
        ./configure --prefix=/opt/sqlite-fixed --disable-static && \
    make -j"$(nproc)" && \
    make install

FROM ghcr.io/astral-sh/uv:0.11.6-python3.13-trixie@sha256:b3c543b6c4f23a5f2df22866bd7857e5d304b67a564f4feab6ac22044dde719b AS uv_source

# ---------------------------------------------------------------------------
# Builder stage: venv (core + telegram extra) + editable install + fts5_cjk.
# Nothing in this stage reaches the pulled image except .venv and the .so —
# the ~300MB build toolchain never enters a shipped layer.
# ---------------------------------------------------------------------------
FROM debian:13.4 AS python_deps
RUN apt-get -o Acquire::Retries=3 update && \
    apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
        build-essential ca-certificates python3 python3-dev && \
    rm -rf /var/lib/apt/lists/*
COPY --chmod=0755 --from=uv_source /usr/local/bin/uv /usr/local/bin/

WORKDIR /opt/hermes
COPY pyproject.toml uv.lock ./
# README.md is excluded from the build context by .dockerignore's `*.md`;
# uv's build frontend stats the path during resolution, so seed a placeholder.
RUN touch ./README.md
RUN uv sync --frozen --no-install-project --extra telegram

# Source tree (trimmed — see the runtime stage for the keep-list rationale).
# Needed here so the editable install can derive root py-modules and write
# the egg-link + console scripts into the venv.
COPY --chmod=a+rX,go-w setup.py *.py hermes ./
COPY --chmod=a+rX,go-w agent/ agent/
COPY --chmod=a+rX,go-w acp_adapter/ acp_adapter/
COPY --chmod=a+rX,go-w cron/ cron/
COPY --chmod=a+rX,go-w gateway/ gateway/
COPY --chmod=a+rX,go-w hermes_cli/ hermes_cli/
COPY --chmod=a+rX,go-w plugins/ plugins/
COPY --chmod=a+rX,go-w providers/ providers/
COPY --chmod=a+rX,go-w tools/ tools/
COPY --chmod=a+rX,go-w tui_gateway/ tui_gateway/
COPY --chmod=a+rX,go-w locales/ locales/
COPY --chmod=a+rX,go-w plugin-catalog/ plugin-catalog/
COPY --chmod=a+rX,go-w skills/ skills/
COPY --chmod=a+rX,go-w scripts/ scripts/
RUN uv pip install --no-cache-dir --no-deps -e "."

# CJK bigram FTS5 tokenizer: built against the vendored sqlite3ext.h headers,
# shipped read-only in the image (HERMES_FTS5_CJK_SO) so runtime never needs gcc.
COPY native/fts5_cjk/ /tmp/fts5_cjk/
RUN bash /tmp/fts5_cjk/build.sh /tmp/fts5_cjk_out

# ---------------------------------------------------------------------------
# Runtime stage: debian + python + the four small supervised services.
# ---------------------------------------------------------------------------
FROM debian:13.4

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

ARG TARGETARCH
RUN apt-get -o Acquire::Retries=3 update && \
    apt-get -o Acquire::Retries=3 install -y --no-install-recommends \
    ca-certificates curl iputils-ping python3 python-is-python3 python3-venv ripgrep git openssh-client openssh-server procps sudo xz-utils && \
    rm -rf /var/lib/apt/lists/*

# Prefer the fixed SQLite over Debian's vulnerable libsqlite3.so.0 (same as stock).
COPY --from=sqlite_build /opt/sqlite-fixed/lib/libsqlite3.so.3.53.4 /usr/local/lib/
RUN ln -sf libsqlite3.so.3.53.4 /usr/local/lib/libsqlite3.so.0 && \
    ln -sf libsqlite3.so.3.53.4 /usr/local/lib/libsqlite3.so && \
    printf '/usr/local/lib\n' > /etc/ld.so.conf.d/000-sqlite-fixed.conf && \
    ldconfig && \
    python3 -c "import sqlite3, sys; \
v = sqlite3.sqlite_version_info; \
sys.exit(f'linked SQLite {sqlite3.sqlite_version} still has the WAL-reset bug') if v < (3, 51, 3) else None; \
db = sqlite3.connect(':memory:'); \
db.execute(\"CREATE VIRTUAL TABLE docs USING fts5(content, tokenize='trigram')\"); \
db.execute(\"INSERT INTO docs VALUES ('hermes')\"); \
sys.exit('SQLite FTS5 trigram self-test failed') if db.execute(\"SELECT count(*) FROM docs WHERE docs MATCH 'erm'\").fetchone()[0] != 1 else None; \
db.close()"

# --- s6-overlay install (same checksums as stock) ---
ARG S6_OVERLAY_VERSION=3.2.3.0
ARG S6_OVERLAY_NOARCH_SHA256=b720f9d9340efc8bb07528b9743813c836e4b02f8693d90241f047998b4c53cf
ARG S6_OVERLAY_X86_64_SHA256=a93f02882c6ed46b21e7adb5c0add86154f01236c93cd82c7d682722e8840563
ARG S6_OVERLAY_AARCH64_SHA256=0952056ff913482163cc30e35b2e944b507ba1025d78f5becbb89367bf344581
ARG S6_OVERLAY_SYMLINKS_SHA256=a60dc5235de3ecbcf874b9c1f18d73263ab99b289b9329aa950e8729c4789f0e
RUN set -eu; \
    case "${TARGETARCH:-amd64}" in \
        amd64) s6_arch="x86_64"; s6_arch_sha="${S6_OVERLAY_X86_64_SHA256}" ;; \
        arm64) s6_arch="aarch64"; s6_arch_sha="${S6_OVERLAY_AARCH64_SHA256}" ;; \
        *) echo "Unsupported TARGETARCH=${TARGETARCH} for s6-overlay" >&2; exit 1 ;; \
    esac; \
    base="https://github.com/just-containers/s6-overlay/releases/download/v${S6_OVERLAY_VERSION}"; \
    curl -fsSL --retry 3 -o /tmp/s6-overlay-noarch.tar.xz \
        "${base}/s6-overlay-noarch.tar.xz"; \
    curl -fsSL --retry 3 -o /tmp/s6-overlay-symlinks-noarch.tar.xz \
        "${base}/s6-overlay-symlinks-noarch.tar.xz"; \
    curl -fsSL --retry 3 -o /tmp/s6-overlay-arch.tar.xz \
        "${base}/s6-overlay-${s6_arch}.tar.xz"; \
    { \
        printf '%s  %s\n' "${S6_OVERLAY_NOARCH_SHA256}" /tmp/s6-overlay-noarch.tar.xz; \
        printf '%s  %s\n' "${s6_arch_sha}" /tmp/s6-overlay-arch.tar.xz; \
        printf '%s  %s\n' "${S6_OVERLAY_SYMLINKS_SHA256}" /tmp/s6-overlay-symlinks-noarch.tar.xz; \
    } > /tmp/s6-overlay.sha256; \
    sha256sum -c /tmp/s6-overlay.sha256; \
    tar -C / -Jxpf /tmp/s6-overlay-noarch.tar.xz; \
    tar -C / -Jxpf /tmp/s6-overlay-arch.tar.xz; \
    tar -C / -Jxpf /tmp/s6-overlay-symlinks-noarch.tar.xz; \
    rm /tmp/s6-overlay-*.tar.xz /tmp/s6-overlay.sha256

# --- cloudflared (TUNNEL_TOKEN remains a supported side service) ---
RUN set -eu; \
    case "${TARGETARCH:-amd64}" in \
        amd64) cf_arch="amd64" ;; \
        arm64) cf_arch="arm64" ;; \
        *) echo "Unsupported TARGETARCH=${TARGETARCH} for cloudflared" >&2; exit 1 ;; \
    esac; \
    curl -fsSL --retry 3 -o /usr/local/bin/cloudflared \
        "https://github.com/cloudflare/cloudflared/releases/latest/download/cloudflared-linux-${cf_arch}" && \
    chmod 0755 /usr/local/bin/cloudflared

# Legacy /usr/bin/tini shim (same compat contract as stock).
COPY --chmod=0755 docker/tini-shim.sh /usr/bin/tini

# Non-root user + sshd config + sudoers (same as stock).
RUN useradd -u 10000 -m -d /opt/data hermes
RUN mkdir -p /etc/ssh/sshd_config.d && \
    { \
        echo "PasswordAuthentication no"; \
        echo "ChallengeResponseAuthentication no"; \
        echo "PubkeyAuthentication yes"; \
        echo "AuthorizedKeysFile .ssh/authorized_keys"; \
        echo "PermitRootLogin yes"; \
        echo "AllowUsers root hermes"; \
        echo "LogLevel VERBOSE"; \
    } > /etc/ssh/sshd_config.d/99-hermes.conf && \
    mkdir -p /opt/data/.ssh && \
    chmod 0700 /opt/data/.ssh && \
    chown hermes:hermes /opt/data/.ssh
RUN echo "hermes ALL=(ALL) NOPASSWD:ALL" > /etc/sudoers.d/hermes && \
    chmod 0440 /etc/sudoers.d/hermes && \
    usermod -aG root hermes

WORKDIR /opt/hermes

# Venv from the builder (core + telegram) and the prebuilt CJK FTS extension.
COPY --from=python_deps /opt/hermes/.venv /opt/hermes/.venv
COPY --from=python_deps /tmp/fts5_cjk_out/libfts5_cjk.so /opt/hermes/lib/libfts5_cjk.so
ENV HERMES_FTS5_CJK_SO=/opt/hermes/lib/libfts5_cjk.so

# Trimmed source tree. Kept: runtime python packages + their package-data,
# bundled skills (boot-time skills sync), plugin catalog manifests, locales,
# docker/ runtime scripts, and the two scripts/ helpers stage2 invokes.
# Cut: website/ evals/ tests/ web/ ui-tui/ apps/ optional-mcps/ optional-skills/.
COPY --chmod=a+rX,go-w pyproject.toml *.py hermes ./
COPY --chmod=a+rX,go-w agent/ agent/
COPY --chmod=a+rX,go-w acp_adapter/ acp_adapter/
COPY --chmod=a+rX,go-w cron/ cron/
COPY --chmod=a+rX,go-w gateway/ gateway/
COPY --chmod=a+rX,go-w hermes_cli/ hermes_cli/
COPY --chmod=a+rX,go-w plugins/ plugins/
COPY --chmod=a+rX,go-w providers/ providers/
COPY --chmod=a+rX,go-w tools/ tools/
COPY --chmod=a+rX,go-w tui_gateway/ tui_gateway/
COPY --chmod=a+rX,go-w locales/ locales/
COPY --chmod=a+rX,go-w plugin-catalog/ plugin-catalog/
COPY --chmod=a+rX,go-w skills/ skills/
COPY --chmod=a+rX,go-w scripts/ scripts/
COPY --chmod=a+rX,go-w docker/ docker/

# Exec shim + install-method stamp + provenance (same contract as stock).
USER root
RUN mkdir -p /opt/hermes/bin /opt/hermes/lib && \
    cp /opt/hermes/docker/hermes-exec-shim.sh /opt/hermes/bin/hermes && \
    chmod 0755 /opt/hermes /opt/hermes/bin/hermes && \
    printf 'docker\n' > /opt/hermes/.install_method
ARG HERMES_GIT_SHA=
RUN set -eu; \
    if [ -n "${HERMES_GIT_SHA}" ]; then \
        printf '%s\n' "${HERMES_GIT_SHA}" > /opt/hermes/.hermes_build_sha; \
    fi; \
    mkdir -p /etc/hermes; \
    HERMES_GIT_SHA="${HERMES_GIT_SHA}" python3 -c 'import json, os, pathlib, tomllib; project = tomllib.loads(pathlib.Path("/opt/hermes/pyproject.toml").read_text(encoding="utf-8"))["project"]; marker = pathlib.Path("/etc/hermes/image-provenance.json"); marker.write_text(json.dumps({"schema": 1, "deployment_kind": "image", "manager": "docker", "image": "nousresearch/hermes-agent", "version": project["version"], "revision": os.environ.get("HERMES_GIT_SHA") or None}, sort_keys=True, separators=(",", ":")) + "\n", encoding="utf-8"); marker.chmod(0o444)'

# --- s6 service wiring: same as stock MINUS the dashboard slot ---
COPY docker/s6-rc.d/ /etc/s6-overlay/s6-rc.d/
RUN rm -rf /etc/s6-overlay/s6-rc.d/dashboard /etc/s6-overlay/s6-rc.d/user/contents.d/dashboard
RUN mkdir -p /etc/cont-init.d && \
    printf '#!/command/with-contenv sh\nexec /opt/hermes/docker/stage2-hook.sh\n' \
        > /etc/cont-init.d/01-hermes-setup && \
    chmod +x /etc/cont-init.d/01-hermes-setup
COPY --chmod=0755 docker/cont-init.d/015-supervise-perms /etc/cont-init.d/015-supervise-perms
COPY --chmod=0755 docker/cont-init.d/02-reconcile-profiles /etc/cont-init.d/02-reconcile-profiles

# --- Runtime env (same as stock, minus the web/TUI dist pointers) ---
ENV HERMES_HOME=/opt/data
ENV HERMES_WRITE_SAFE_ROOT=/opt/data
ENV HERMES_DISABLE_LAZY_INSTALLS=1
ENV HERMES_LAZY_INSTALL_TARGET=/opt/data/lazy-packages
COPY --chmod=0755 docker/hermes-exec-shim.sh /opt/hermes/bin/hermes
COPY --chmod=0755 docker/entrypoint-dispatch.sh /opt/hermes/docker/entrypoint-dispatch.sh
ENV PATH="/opt/hermes/bin:/opt/hermes/.venv/bin:/opt/data/.local/bin:${PATH}"
RUN mkdir -p /opt/data
VOLUME [ "/opt/data" ]

ENTRYPOINT [ "/opt/hermes/docker/entrypoint-dispatch.sh" ]
CMD [ ]
