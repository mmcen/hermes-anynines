#!/command/with-contenv sh
# shellcheck shell=sh
# Cloudflare Tunnel service (cloudflared).
# Requires TUNNEL_TOKEN environment variable.

set -e

case "${TUNNEL_TOKEN:-}" in
    "")
        echo "[cloudflared] TUNNEL_TOKEN not set — service disabled" >&2
        exit 0
        ;;
esac

# Drop to hermes user if running as root (same pattern as dashboard/run).
# NOTE: the previous `[ root ] && set -- s6-setuidgid ...` then
# `exec cloudflared` did NOT actually drop privileges — the exec line
# hard-coded `cloudflared` and never used $@, so cloudflared kept running
# as root. Fixed by choosing the exec line up front.
[ "$(id -u)" = 0 ] || exec cloudflared tunnel --no-autoupdate --loglevel info run --token "${TUNNEL_TOKEN}"
exec s6-setuidgid hermes cloudflared tunnel \
    --no-autoupdate --loglevel info run --token "${TUNNEL_TOKEN}"