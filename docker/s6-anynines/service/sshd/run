#!/bin/sh
# shellcheck shell=sh
# sshd — supervised by s6 (anynines/CF fallback path).
#
# Reuses the stock s6-rc.d script: host-key generation, authorized_keys
# seeding from SSH_PUBLIC_KEY, and the port choice (defaults to 22 here;
# 2222 belongs to the platform's own diego-sshd). sshd must keep root,
# which the stock script handles.
#
# Output is captured to a file (see `s6 logs sshd`).
exec /command/with-contenv sh /etc/s6-overlay/s6-rc.d/sshd/run \
    >>"${HERMES_HOME:-/opt/data}/logs/sshd.log" 2>&1
