#!/bin/sh
# shellcheck shell=sh
# ===========================================================================
#  s6 — service control & configuration menu
#  hermes-agent-docker on anynines / CloudFoundry
#
#  Services (gateway, cloudflared, dashboard, sshd) are supervised by a
#  plain s6-svscan tree in the CF fallback path — the platform owns PID 1,
#  so s6 runs as the container's main process instead.
#
#  Quick reference:
#    s6                     interactive menu (中文)
#    s6 status              service overview
#    s6 start   <svc|all>   start a service
#    s6 stop    <svc|all>   stop a service (stays down)
#    s6 restart <svc|all>   restart a service
#    s6 logs    <svc> [-f]  tail a service log (-f to follow) [errors too]
#    s6 conf                show effective configuration (secrets masked)
#    s6 set     KEY=VALUE   add/update a setting in $HERMES_HOME/.env
#    s6 unset   KEY         remove a setting
#    s6 apply               apply config changes (restarts the gateway)
#    s6 doctor              self-check (PID 1, services, perms, provider keys)
#    s6 help                this text
# ===========================================================================

HERMES_HOME="${HERMES_HOME:-/opt/data}"
LOGDIR="$HERMES_HOME/logs"
ENVFILE="$HERMES_HOME/.env"
KNOWNSVC="gateway cloudflared dashboard sshd"

# --- locate the supervision tree -------------------------------------------
# Two layouts exist and this menu must work in both:
#   * CF / non-PID-1 fallback → /run/s6-anynines/service, assembled by
#     entrypoint-anynines.sh (gateway is a supervised service there).
#   * PID-1 platforms (plain Docker, Railway, Fly …) → s6-overlay owns the
#     tree; live service dirs sit under /run/service and hermes registers the
#     gateway itself as `gateway-<profile>`.
# Pick the first candidate that actually holds service slots we recognise.
detect_scandir() {
    if [ -n "${S6_SCANDIR:-}" ] && [ -d "$S6_SCANDIR" ]; then
        printf '%s' "$S6_SCANDIR"
        return
    fi
    for d in /run/s6-anynines/service /run/hermes-s6/service /run/service /run/s6-rc/servicedirs; do
        [ -d "$d" ] || continue
        for cand in "$d"/*; do
            [ -d "$cand" ] || continue
            case "$(basename "$cand")" in
                gateway|gateway-*|cloudflared|dashboard|sshd|main-hermes)
                    printf '%s' "$d"
                    return ;;
            esac
        done
    done
    for d in /run/s6-anynines/service /run/hermes-s6/service /run/service; do
        [ -d "$d" ] && { printf '%s' "$d"; return; }
    done
    printf '%s' /run/service
}

SCANDIR="$(detect_scandir)"

PATH="/command:/package/admin/s6/command:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:$PATH"
export PATH

die() { printf 's6: %s\n' "$*" >&2; exit 1; }
hint() { printf '   → %s\n' "$*"; }

# --- helpers ---------------------------------------------------------------

mask() {
    v="$1"
    if [ -z "$v" ]; then printf '(unset)'; return; fi
    n=${#v}
    if [ "$n" -le 10 ]; then printf '********'; return; fi
    printf '%s…%s (len=%s)' "$(printf '%s' "$v" | cut -c1-6)" \
        "$(printf '%s' "$v" | cut -c$((n - 3))-$n)" "$n"
}

env_value() {
    # last matching assignment in $ENVFILE wins; strips simple quotes
    [ -f "$ENVFILE" ] || return 0
    v="$(sed -n "s/^[[:space:]]*$1=//p" "$ENVFILE" 2>/dev/null | tail -n 1)"
    case "$v" in
        \"*\") v="${v#\"}"; v="${v%\"}" ;;
        \'*\') v="${v#\'}"; v="${v%\'}" ;;
    esac
    printf '%s' "$v"
}

enabled_services() {
    [ -d "$SCANDIR" ] || return 0
    for d in "$SCANDIR"/*; do
        [ -d "$d" ] || continue
        case "$(basename "$d")" in .*) continue ;; esac
        basename "$d"
    done
}

# Only the services this image ships (plus hermes' own gateway slots and any
# user-defined service) — the s6-overlay tree on PID-1 platforms also holds
# internals like base, fix-attrs, legacy-cont-init, s6rc-oneshot-runner, which
# would drown the table.
S6_BUILTIN_SVC="gateway cloudflared dashboard sshd main-hermes"

is_builtin_service() {
    case "$1" in
        gateway|gateway-*|cloudflared|dashboard|sshd|main-hermes) return 0 ;;
    esac
    return 1
}

hermes_services() {
    for s in $(enabled_services); do
        if is_builtin_service "$s" || is_user_service "$s"; then
            printf '%s\n' "$s"
        fi
    done
}

other_services_count() {
    n=0
    for s in $(enabled_services); do
        if ! is_builtin_service "$s" && ! is_user_service "$s"; then
            n=$((n + 1))
        fi
    done
    printf '%s' "$n"
}

# --- user-defined services -------------------------------------------------
# Definitions live in $HERMES_HOME/s6-services/<name>/run so they survive
# restarts wherever the state dir is persistent. They are installed into the
# live scan directory at boot by entrypoint-anynines.sh (CF fallback path) and
# by /etc/cont-init.d/05-anynines-user-services (PID-1 s6-overlay path).
USER_SVC_DIR="$HERMES_HOME/s6-services"

user_services() {
    [ -d "$USER_SVC_DIR" ] || return 0
    for d in "$USER_SVC_DIR"/*; do
        [ -d "$d" ] || continue
        case "$(basename "$d")" in .*) continue ;; esac
        basename "$d"
    done
}

is_user_service() { [ -d "$USER_SVC_DIR/${1:-}" ]; }

rescan_live() {
    s6-svscanctl -a "$SCANDIR" 2>/dev/null ||
        /command/s6-svscanctl -a "$SCANDIR" 2>/dev/null || true
}

install_user_service() {
    n="$1"
    [ -d "$SCANDIR" ] || return 0
    rm -rf "$SCANDIR/$n"
    cp -R "$USER_SVC_DIR/$n" "$SCANDIR/$n" 2>/dev/null || return 0
    chmod 0755 "$SCANDIR/$n" "$SCANDIR/$n/run" 2>/dev/null || true
    rescan_live
    sleep 1
    s6-svc -u "$SCANDIR/$n" 2>/dev/null || true
}

# s6 add <name> [--root] -- <command...>
#   registers a longrun service that s6 supervises (restart on crash) and that
#   is restored automatically on the next container start. By default it runs
#   as the hermes user; --root keeps root.
cmd_add() {
    require_s6
    name=""; run_as_root=0; cmd=""
    while [ $# -gt 0 ]; do
        case "$1" in
            --root) run_as_root=1 ;;
            --) shift; cmd="$*"; break ;;
            -h|--help) printf 'usage: s6 add <name> [--root] -- <command...>\n'; return 0 ;;
            *) if [ -z "$name" ]; then name="$1"; else cmd="${cmd:+$cmd }$1"; fi ;;
        esac
        shift
    done
    [ -n "$name" ] || die "usage: s6 add <name> [--root] -- <command...>"
    case "$name" in
        .*|*[!A-Za-z0-9._-]*) die "invalid service name '$name' (letters, digits, . _ - only)" ;;
    esac
    if is_builtin_service "$name"; then
        die "'$name' collides with a built-in service name"
    fi
    if [ -z "$cmd" ]; then
        printf '要守护的命令 (e.g. /usr/bin/myserver --port 8080): '
        read -r cmd || true
    fi
    [ -n "$cmd" ] || die "no command given"
    esc="$(printf '%s' "$cmd" | sed "s/'/'\\\\''/g")"
    mkdir -p "$USER_SVC_DIR/$name" || die "cannot write $USER_SVC_DIR"
    {
        printf '#!/bin/sh\n'
        printf '# user service %s — managed by the `s6` menu (s6 add / s6 rm)\n' "$name"
        printf '# stored at %s/run; installed into %s at boot\n' "$USER_SVC_DIR/$name" "$SCANDIR"
        printf 'set -e\n'
        printf 'cd "%s" 2>/dev/null || true\n' "$HERMES_HOME"
        if [ "$run_as_root" = 1 ]; then
            printf "exec sh -c '%s'\n" "$esc"
        else
            printf 'if [ "$(id -u)" = 0 ]; then\n'
            printf "    exec s6-setuidgid hermes sh -c '%s'\n" "$esc"
            printf 'fi\n'
            printf "exec sh -c '%s'\n" "$esc"
        fi
    } >"$USER_SVC_DIR/$name/run"
    chmod 0755 "$USER_SVC_DIR/$name" "$USER_SVC_DIR/$name/run" 2>/dev/null || true
    chown --reference="$HERMES_HOME" "$USER_SVC_DIR" "$USER_SVC_DIR/$name" 2>/dev/null || true
    printf 's6: service %s saved (%s) and start requested\n' "$name" "$USER_SVC_DIR/$name/run"
    install_user_service "$name"
    sleep 1
    cmd_status
}

# s6 rm <name> — stop and delete a user-defined service (built-ins protected)
cmd_rm() {
    require_s6
    name="$1"
    [ -n "$name" ] || die "usage: s6 rm <name>"
    is_user_service "$name" ||
        die "'$name' is not a user-defined service (built-ins cannot be removed here)"
    if [ -d "$SCANDIR/$name" ]; then
        s6-svc -d "$SCANDIR/$name" 2>/dev/null || true
        i=0
        while [ "$i" -lt 5 ] && s6-svstat -u "$SCANDIR/$name" >/dev/null 2>&1; do
            sleep 1
            i=$((i + 1))
        done
        rm -rf "$SCANDIR/$name"
        rescan_live
    fi
    rm -rf "$USER_SVC_DIR/$name"
    printf 's6: service %s removed\n' "$name"
    sleep 1
    cmd_status
}

targets_of() {
    if [ "$1" = "all" ]; then enabled_services; else printf '%s\n' "$1"; fi
}

svc_state() {
    d="$SCANDIR/$1"
    [ -d "$d" ] || { printf 'not enabled'; return; }
    s6-svstat "$d" 2>&1 | head -n 1
}

proc_owner() {
    # login name of the process s6 currently runs for a service
    pid="$(s6-svstat -o pid "$SCANDIR/$1" 2>/dev/null)"
    case "$pid" in ''|*[!0-9]*) printf -- '-'; return ;; esac
    uid="$(awk '/^Uid:/{print $2}' "/proc/$pid/status" 2>/dev/null)"
    [ -n "$uid" ] || { printf -- '-'; return; }
    name="$(awk -F: -v u="$uid" '$3==u{print $1; exit}' /etc/passwd 2>/dev/null)"
    printf '%s' "${name:-uid:$uid}"
}

is_up() { s6-svstat -u "$SCANDIR/$1" >/dev/null 2>&1; }

# Name of the gateway's service slot in this layout, if any. The CF fallback
# names it `gateway`; on PID-1 platforms hermes registers the gateway in the
# s6-overlay tree as `gateway-<profile>` instead.
gateway_service() {
    [ -d "$SCANDIR" ] || return 1
    for cand in "$SCANDIR"/gateway "$SCANDIR"/gateway-*; do
        [ -d "$cand" ] || continue
        basename "$cand"
        return 0
    done
    return 1
}

run_mode_label() {
    gw="$(gateway_service 2>/dev/null || true)"
    if [ -z "$gw" ]; then
        printf 'gateway runs as the container main process (no gateway slot here)'
        return
    fi
    case "$(proc_owner "$gw")" in
        root) printf 'root (opt-in, HERMES_ALLOW_ROOT_GATEWAY)' ;;
        hermes) printf 'hermes (privilege drop via main-wrapper)' ;;
        *) printf 'unknown (gateway not running)' ;;
    esac
}

require_s6() {
    command -v s6-svscan >/dev/null 2>&1 ||
        die "s6 tools not found — is this container running under CF with the anynines image?"
}

svscan_pids() {
    # Portable process lookup (no pgrep dependency).
    for p in /proc/[0-9]*; do
        [ -r "$p/cmdline" ] || continue
        case "$(tr '\0' ' ' <"$p/cmdline" 2>/dev/null)" in
            *s6-svscan*) printf '%s ' "${p#/proc/}" ;;
        esac
    done
}

net_probe() {
    if command -v timeout >/dev/null 2>&1; then
        timeout 5 getent hosts api.telegram.org >/dev/null 2>&1
    else
        getent hosts api.telegram.org >/dev/null 2>&1
    fi
}

# --- commands --------------------------------------------------------------

cmd_status() {
    printf '\ns6 service status  (scandir=%s)\n' "$SCANDIR"
    printf '──────────────────────────────────────────────────────────\n'
    if [ ! -d "$SCANDIR" ]; then
        printf '  %-12s %s\n' "(none)" "scandir missing — is the container running?"
        return
    fi
    printf '  %-16s %-6s %s\n' "service" "owner" "state"
    any=0
    for s in $(hermes_services); do
        printf '  %-16s %-6s %s\n' "$s" "$(proc_owner "$s")" "$(svc_state "$s")"
        any=1
    done
    [ "$any" = 0 ] && printf '  %-16s %s\n' "(nothing)" "no supervised services found"
    for s in $KNOWNSVC; do
        [ -d "$SCANDIR/$s" ] || printf '  %-16s %-6s %s\n' "$s" "-" "not supervised here (disabled, or handled by the platform)"
    done
    if [ "$(other_services_count)" != 0 ]; then
        printf '  %-16s %s\n' "(+$(other_services_count))" "s6-overlay internal services not listed"
    fi
    printf '\n'
    printf '  mode            %s\n' "$(run_mode_label)"
    printf '  provider key    %s\n' \
        "$(for k in NOUS_API_KEY OPENROUTER_API_KEY OPENAI_API_KEY ANTHROPIC_API_KEY; do
              v="$(env_value "$k")"; [ -n "$v" ] && { printf '%s' "$k"; break; }; done)"
    printf '  user services   %s\n' "$(user_services | tr '\n' ' ' | sed 's/ $//; s/^$/(none)/')"
    printf '  logs            %s   (s6 logs <service>)\n' "$LOGDIR"
    gw="$(gateway_service 2>/dev/null || true)"
    if [ -n "$gw" ] && ! is_up "$gw"; then
        printf '\n'
        hint "$gw is NOT up — check: s6 logs gateway"
        hint "crash history: tail $LOGDIR/gateway-crash.log"
    fi
}

cmd_ctl() {
    action="$1"; name="$2"
    [ -n "$name" ] || die "usage: s6 $action <service|all>"
    require_s6
    [ -d "$SCANDIR" ] || die "scandir $SCANDIR missing — s6 not running"
    case "$action" in start|stop|restart) ;; *) die "bad action $action" ;; esac
    for s in $(targets_of "$name"); do
        d="$SCANDIR/$s"
        if [ ! -d "$d" ]; then
            printf 's6: %s not enabled — skipped\n' "$s"
            continue
        fi
        case "$action" in
            start) s6-svc -u "$d" ;;
            stop)  s6-svc -d "$d" ;;
            restart)
                if is_up "$s"; then s6-svc -t "$d"; else s6-svc -u "$d"; fi
                ;;
        esac
        printf 's6: %s %s requested\n' "$s" "$action"
    done
    sleep 2
    cmd_status
}

cmd_logs() {
    svc="$1"; shift 2>/dev/null || true
    follow=0; n=40
    while [ $# -gt 0 ]; do
        case "$1" in
            -f|--follow) follow=1 ;;
            -n) shift; [ $# -gt 0 ] && n="$1" ;;
            *[0-9]*) n="$1" ;;
            *) die "usage: s6 logs <gateway|cloudflared|dashboard|sshd|errors> [-n N] [-f]" ;;
        esac
        shift
    done
    case "$svc" in
        gateway|cloudflared|dashboard|sshd|errors|gateway-crash) f="$LOGDIR/$svc.log" ;;
        "") die "usage: s6 logs <gateway|cloudflared|dashboard|sshd|errors> [-n N] [-f]" ;;
        *) die "unknown service '$svc' (known: $KNOWNSVC errors)" ;;
    esac
    [ -f "$f" ] || die "no log file yet: $f"
    if [ "$follow" = 1 ]; then
        printf 's6: following %s (Ctrl-C to stop)\n' "$f"
        exec tail -n "$n" -f "$f"
    fi
    tail -n "$n" "$f"
}

cmd_conf() {
    printf '\ns6 configuration\n'
    printf '──────────────────────────────────────────────────────────\n'
    printf '  %-32s %s\n' "HERMES_HOME" "$HERMES_HOME"
    printf '  %-32s %s\n' "run mode" "$(run_mode_label)"
    printf '  %-32s %s\n' "data dir writable" "$([ -w "$HERMES_HOME" ] && echo yes || echo NO)"
    printf '  %-32s %s\n' "config.yaml" "$([ -f "$HERMES_HOME/config.yaml" ] && echo "$HERMES_HOME/config.yaml" || echo '(none)')"
    printf '  %-32s %s\n' ".env" "$([ -f "$ENVFILE" ] && echo "$ENVFILE" || echo '(none)')"
    printf '\n  Platform env (secrets masked)\n'
    for k in HERMES_DASHBOARD HERMES_DASHBOARD_HOST HERMES_DASHBOARD_BASIC_AUTH_USERNAME \
             SSH_ENABLED SSH_PORT TELEGRAM_ALLOWED_USERS; do
        eval "v=\${$k:-}"
        printf '    %-38s %s\n' "$k" "${v:-(unset)}"
    done
    for k in HERMES_DASHBOARD_BASIC_AUTH_PASSWORD HERMES_DASHBOARD_BASIC_AUTH_SECRET \
             TUNNEL_TOKEN TELEGRAM_BOT_TOKEN; do
        eval "v=\${$k:-}"
        printf '    %-38s %s\n' "$k" "$(mask "$v")"
    done
    printf '\n  Provider keys in %s (masked)\n' "$ENVFILE"
    found=0
    for k in NOUS_API_KEY OPENROUTER_API_KEY OPENAI_API_KEY ANTHROPIC_API_KEY GEMINI_API_KEY; do
        v="$(env_value "$k")"
        if [ -n "$v" ]; then printf '    %-38s %s\n' "$k" "$(mask "$v")"; found=1; fi
    done
    [ "$found" = 0 ] && printf '    (none set — the gateway needs at least one inference provider key)\n'
    printf '\n'
    hint "set one with: s6 set NOUS_API_KEY=xxxx   then: s6 apply"
}

cmd_set() {
    kv="$1"
    [ -n "$kv" ] || die "usage: s6 set KEY=VALUE"
    case "$kv" in *=*) ;; *) die "usage: s6 set KEY=VALUE" ;; esac
    key="${kv%%=*}"; val="${kv#*=}"
    case "$key" in
        [A-Za-z_]*) ;;
        *) die "invalid key '$key'" ;;
    esac
    case "$key" in
        *[!A-Za-z0-9_]*) die "invalid key '$key' (letters, digits, underscore only)" ;;
    esac
    mkdir -p "$(dirname "$ENVFILE")" 2>/dev/null || true
    touch "$ENVFILE" 2>/dev/null || die "cannot write $ENVFILE"
    tmp="$ENVFILE.s6.$$"
    grep -v "^[[:space:]]*$key=" "$ENVFILE" >"$tmp" 2>/dev/null || true
    printf '%s=%s\n' "$key" "$val" >>"$tmp"
    # Match the data dir's owner (hermes on /opt/data, root in root mode)
    # instead of hardcoding a user.
    chown --reference="$HERMES_HOME" "$tmp" 2>/dev/null || true
    chmod 600 "$tmp" 2>/dev/null || true
    mv "$tmp" "$ENVFILE"
    chown --reference="$HERMES_HOME" "$ENVFILE" 2>/dev/null || true
    printf 's6: %s saved to %s\n' "$key" "$ENVFILE"
    hint "apply with: s6 apply    (restarts the gateway)"
}

cmd_unset() {
    key="$1"
    [ -n "$key" ] || die "usage: s6 unset KEY"
    [ -f "$ENVFILE" ] || die "no $ENVFILE"
    tmp="$ENVFILE.s6.$$"
    grep -v "^[[:space:]]*$key=" "$ENVFILE" >"$tmp" 2>/dev/null || true
    chown --reference="$HERMES_HOME" "$tmp" 2>/dev/null || true
    chmod 600 "$tmp" 2>/dev/null || true
    mv "$tmp" "$ENVFILE"
    printf 's6: %s removed from %s\n' "$key" "$ENVFILE"
    hint "apply with: s6 apply"
}

cmd_apply() {
    require_s6
    printf 's6: applying configuration — restarting the gateway...\n'
    gw="$(gateway_service 2>/dev/null || true)"
    if [ -n "$gw" ]; then
        if is_up "$gw"; then s6-svc -t "$SCANDIR/$gw"; else s6-svc -u "$SCANDIR/$gw"; fi
    else
        # PID-1 layout (e.g. Railway): hermes runs the gateway itself, so let
        # the CLI do the restart instead of a service slot.
        command -v hermes >/dev/null 2>&1 ||
            die "no gateway service slot found in $SCANDIR and the hermes CLI is unavailable"
        hermes gateway restart || die "hermes gateway restart failed"
    fi
    sleep 4
    cmd_status
    printf '\n  recent gateway log:\n'
    tail -n 12 "$LOGDIR/gateway.log" 2>/dev/null | sed 's/^/    /' || true
}

cmd_doctor() {
    printf '\ns6 doctor\n'
    printf '──────────────────────────────────────────────────────────\n'
    p1="$(tr '\0' ' ' </proc/1/cmdline 2>/dev/null)"
    printf '  %-26s %s\n' "PID 1" "${p1:-unknown}"
    case "$p1" in
        *garden-init*) printf '  %-26s %s\n' "" "(platform init — CF mode: s6 supervises as child)" ;;
        *) printf '  %-26s %s\n' "" "(image owns PID 1 — s6-overlay /init path)" ;;
    esac
    printf '  %-26s %s\n' "s6-svscan" "$(command -v s6-svscan 2>/dev/null || echo MISSING)"
    printf '  %-26s %s\n' "svscan running" "$(pids="$(svscan_pids)"; [ -n "$pids" ] && echo "yes (pid ${pids% })" || echo NO)"
    if [ -d "$SCANDIR" ]; then
        printf '  %-26s %s\n' "scandir" "$SCANDIR"
        printf '  %-26s %s\n' "supervised" "$(hermes_services | tr '\n' ' ')"
    else
        printf '  %-26s %s\n' "scandir" "MISSING ($SCANDIR)"
    fi
    printf '\n'
    printf '  %-16s %-6s %s\n' "service" "owner" "state"
    for s in $(hermes_services); do
        printf '  %-16s %-6s %s\n' "$s" "$(proc_owner "$s")" "$(svc_state "$s")"
    done
    printf '\n  %-26s %s\n' "run mode" "$(run_mode_label)"
    printf '  %-26s %s\n' "HERMES_HOME" "$HERMES_HOME"
    printf '  %-26s %s\n' "HERMES_HOME writable" "$([ -w "$HERMES_HOME" ] && echo yes || echo NO)"
    printf '  %-26s %s\n' "net egress" "$(net_probe && echo ok || echo 'check failed')"
    df -h "$HERMES_HOME" 2>/dev/null | tail -n 1 | awk '{printf "  %-26s %s used of %s (%s)\n", "disk", $3, $2, $5}'
    free -m 2>/dev/null | awk '/Mem:/ {printf "  %-26s %s MB used of %s MB\n", "memory", $3, $2}'
    printf '\n  provider keys\n'
    found=0
    for k in NOUS_API_KEY OPENROUTER_API_KEY OPENAI_API_KEY ANTHROPIC_API_KEY; do
        [ -n "$(env_value "$k")" ] && { printf '    %-28s %s\n' "$k" "set"; found=1; }
    done
    [ "$found" = 0 ] && printf '    %s\n' "NONE — the gateway cannot call a model (s6 set NOUS_API_KEY=...)"
    if [ -f "$LOGDIR/gateway-crash.log" ]; then
        printf '\n  recent gateway crashes\n'
        tail -n 5 "$LOGDIR/gateway-crash.log" | sed 's/^/    /'
    fi
    printf '\n'
}

cmd_help() {
    cat <<'EOF'
s6 — service control & configuration menu (hermes-agent-docker / anynines)

  s6                       interactive menu (中文)
  s6 status                service overview (also: s6 list)
  s6 start   <svc|all>     start a service          (svc: gateway|cloudflared|dashboard|sshd)
  s6 stop    <svc|all>     stop a service (stays down until started again)
  s6 restart <svc|all>     restart a service
  s6 logs    <svc> [-n N] [-f]
                           tail a service log; also: errors, gateway-crash
  s6 add     <name> [--root] -- <command...>
                           register a custom service that s6 supervises
                           (restart on crash, re-installed automatically at boot)
  s6 rm      <name>        stop and delete a custom service
  s6 conf                  effective configuration (secrets masked)
  s6 set     KEY=VALUE     add/update a setting in $HERMES_HOME/.env
  s6 unset   KEY           remove a setting
  s6 apply                 apply config (restarts the gateway)
  s6 doctor                self-check: PID 1, services, perms, provider keys, disk
  s6 help                  this text

Notes
  • Services are supervised by s6-svscan; a crashed service is restarted
    automatically (~1/s max). `s6 stop` marks it wanted-down so it stays down.
  • Custom services live in $HERMES_HOME/s6-services/<name>/run and are
    re-installed at boot (by entrypoint-anynines.sh on non-PID-1 platforms, by
    /etc/cont-init.d/05-anynines-user-services under s6-overlay). They run as
    the hermes user unless --root is passed, e.g.
      s6 add webhook -- /usr/bin/python3 /opt/data/webhook.py
  • Image updates are NOT done from inside the container: push a new image
    tag and re-deploy with `cf push` (see docs/anynines-deployment.md).
  • Config lives in $HERMES_HOME/.env (data dir is ephemeral on this platform —
    a new `cf push` or instance restart starts from a clean slate).
EOF
}

menu_pick_service() {
    printf '服务 (gateway/cloudflared/dashboard/sshd/all): '
    read -r svc || return
    [ -n "$svc" ] || return
    cmd_ctl "$1" "$svc"
}

cmd_menu() {
    while :; do
        cat <<'EOF'

  ┌─ s6 管理菜单 · hermes-agent-docker (anynines) ─────────────┐
  │  1) 状态总览                status                        │
  │  2) 启动服务                start <svc|all>               │
  │  3) 停止服务                stop <svc|all>                │
  │  4) 重启服务                restart <svc|all>             │
  │  5) 查看日志                logs <svc> [-f]               │
  │  6) 查看配置 (脱敏)         conf                          │
  │  7) 添加/修改配置           set KEY=VALUE                 │
  │  8) 应用配置 (重启 gateway) apply                         │
  │  9) 体检                    doctor                        │
  │  a) 添加自定义服务          add <name> -- <cmd>           │
  │  d) 删除自定义服务          rm <name>                     │
  │  h) 帮助                    help                          │
  │  0) 退出                                                  │
  └───────────────────────────────────────────────────────────┘
EOF
        printf '选择 [0-9/h]: '
        read -r choice || break
        case "$choice" in
            1) cmd_status ;;
            2) menu_pick_service start ;;
            3) menu_pick_service stop ;;
            4) menu_pick_service restart ;;
            5) printf '服务: '; read -r s; [ -n "$s" ] && cmd_logs "$s" ;;
            6) cmd_conf ;;
            7) printf 'KEY=VALUE: '; read -r kv; [ -n "$kv" ] && cmd_set "$kv" ;;
            8) cmd_apply ;;
            9) cmd_doctor ;;
            a|A)
                printf '服务名: '
                read -r n || break
                [ -n "$n" ] || continue
                printf '要守护的命令: '
                read -r c || break
                [ -n "$c" ] && cmd_add "$n" -- $c
                ;;
            d|D)
                printf '服务名: '
                read -r n || break
                [ -n "$n" ] && cmd_rm "$n"
                ;;
            h|H|help) cmd_help ;;
            0|q|Q|exit) break ;;
            '') ;;
            *) printf '无效选择: %s\n' "$choice" ;;
        esac
    done
}

# --- dispatch --------------------------------------------------------------

case "${1:-}" in
    ""|menu|m)              cmd_menu ;;
    status|st|s)            cmd_status ;;
    start)                  cmd_ctl start "${2:-}" ;;
    stop)                   cmd_ctl stop "${2:-}" ;;
    restart|reload)         cmd_ctl restart "${2:-}" ;;
    logs|log|l)             shift; cmd_logs "$@" ;;
    conf|config|show)       cmd_conf ;;
    add|svc-add)            shift; cmd_add "$@" ;;
    rm|svc-rm)              cmd_rm "${2:-}" ;;
    list|ls)                cmd_status ;;
    set)                    cmd_set "${2:-}" ;;
    unset)                  cmd_unset "${2:-}" ;;
    apply|update|up)        cmd_apply ;;
    doctor|check|health)    cmd_doctor ;;
    help|-h|--help)         cmd_help ;;
    *)                      cmd_help; exit 1 ;;
esac
